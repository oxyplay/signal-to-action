# Copy to .env to override the local defaults. Everything has a working default,
# so the demo runs without this file.

# Grafana login for http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Which decision backend the evaluator uses:
#   rules   deterministic baseline, no external calls (default)
#   jev     semantic classification only
#   compare both engines against the same Observation
DECISION_ENGINE=rules

# Host ports, in case 3002 or 8081 is already taken on your machine.
DEMO_APP_PORT=3002
EVALUATOR_PORT=8081

# --- Jev via OpenRouter -------------------------------------------------
# Only needed for DECISION_ENGINE=jev or compare. Leave empty otherwise; the
# rules engine never calls out. Never commit a real key.
OPENROUTER_API_KEY=

# Pinned for reproducibility. ~typesafe/jev-latest tracks the newest release.
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Below this confidence the Jev classification is not used as-is and the
# assessment is downgraded to OBSERVE.
JEV_MIN_CONFIDENCE=0.65

# One attempt, no retries, so latency and failure behaviour stay readable.
# Operational timeout for a single Jev call, chosen from measured OpenRouter
# latency rather than from a performance claim. One attempt, no retries.
# Default 10000 for the interactive evaluator. npm run eval defaults to 15000
# because it makes many calls in quick succession; override either with this.
JEV_TIMEOUT_MS=10000

# Host-side only (npm run eval): point Jev at a proxy or a mock instead of
# OpenRouter. Not wired into docker-compose.yml on purpose.
# JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
